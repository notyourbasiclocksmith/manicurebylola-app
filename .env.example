# ============================================================
# Manicure by Lola — Variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# ============================================================

# --- Base de datos (Render PostgreSQL) ---
# En local puedes usar Postgres local o la "External Database URL" de Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- URL pública del sitio ---
NEXT_PUBLIC_SITE_URL="https://manicurebylola.com"

# --- Stripe (pega tus claves cuando abras la cuenta) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
# Secreto del webhook (stripe listen / dashboard > webhooks)
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# --- Panel de administración ---
# Contraseña que usará Lola para entrar a /admin
ADMIN_PASSWORD="cambia-esta-clave"
# Secreto largo y aleatorio para firmar la sesión (genera uno con: openssl rand -hex 32)
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Subida de imágenes de la galería ---
# En local deja el valor por defecto. En Render monta un disco persistente
# (p.ej. en /var/data) y pon UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR="./public/uploads"
